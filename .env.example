# Marketplace API (marketplace-service). The directory falls back to the local
# catalog when this origin is unreachable.
VITE_MARKETPLACE_API_URL=https://api.marketplace.shellui.com

# Published dev-server origin and port (defaults: http://localhost:5176).
# VITE_DEV_ORIGIN=http://localhost:5176
# VITE_DEV_PORT=5176

# macOS bind mounts: set to true when file changes are not detected inside Docker.
# VITE_USE_POLLING=true
